                <mxCell id="4" value="PropDevelopment [Software System Boundary]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#666666;fontColor=#666666;verticalAlign=top;fontSize=12;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="320" y="60" width="1100" height="1100" as="geometry"/>
