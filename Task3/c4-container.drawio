                <mxCell id="5" value="Моб.приложение для собственников  [Container: iOS/Android] UI + локальное хранилище. [ИЗМЕНЕНО]: добавлены экраны «Умный дом»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#82B366;strokeWidth=3;fontColor=#FFFFFF;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="360" y="120" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="API Gateway / BFF  [Container: nginx + Lua / Envoy] [НОВОЕ или усиленное] Единая точка входа моб.приложения. Proверяет JWT, применяет rate-limit, маршрутизирует к back-end сервисам." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#82B366;strokeWidth=3;fontColor=#FFFFFF;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="360" y="290" width="280" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="tenant-core-app  [Container: Spring Boot] Сервисы для собственников: платежи, ремонт, обращения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="720" y="290" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="tenant-core-db  [Postgres] ПДн собственников, привязка к домам и квартирам" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="720" y="460" width="280" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="smart-home-bridge-app  [Container: Spring Boot] [НОВОЕ] Прозрачно проксирует и нормализует команды между PropDev и платформой. Кеширует ACL, валидирует webhook, применяет tenant-isolation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#82B366;strokeWidth=3;fontColor=#FFFFFF;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="1080" y="290" width="290" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="smart-home-db  [Postgres] [НОВОЕ] Локальные ACL, идемпотентные ключи, аудит-лог событий доступа" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#82B366;strokeWidth=3;fontColor=#FFFFFF;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="1080" y="510" width="290" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="Active Directory  [Container] UserAccount-ы собственников и сотрудников УК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="360" y="680" width="280" height="130" as="geometry"/>
